      "maintainer_scripts": {
        "./postinst": "#!/bin/sh\n# Copyright (C) 2020 OpenCFD Ltd.\n# SPDX-License-Identifier: (GPL-3.0+)\n#\n# A postinst for openfoam2412 runtime - see dh_installdeb(1)\n# See http://www.debian.org/doc/debian-policy/ or\n# the debian-policy package\n\nprefix=\"/usr/lib/openfoam\"\npackage=\"${DPKG_MAINTSCRIPT_PACKAGE}\"\nprojectDir=\"$prefix/$package\"\nselector=\"/usr/bin/openfoam-selector\"\n\nset -e\ncase \"$1\" in\nconfigure)\n    # Replace installation path with hard-coded value\n    if [ -d \"$projectDir\" ]\n    then\n    (\n        cd \"$projectDir\" || exit\n        echo \"Update installation directory for $package\"\n        bin/tools/foamConfigurePaths \\\n            -project-path \"$projectDir\"\n    )\n    fi\n\n    # Register with openfoam-selector if possible\n    if [ -f \"$selector\" ] && [ -x \"$selector\" ]\n    then\n        if \"$selector\" \\\n            --register \"$package\" \\\n            --source-dir \"$projectDir\" \\\n            --yes\n        then\n            echo \"Registered '$package' with openfoam-selector\"\n            selector=\"openfoam-selector --set $package\"\n        else\n            echo \"Failed to register '$package' with openfoam-selector\"\n            selector=\"[openfoam-selector failed]\"\n        fi\n    else\n        echo \"Did not register '$package' [openfoam-selector missing]\"\n        selector=\"[openfoam-selector missing]\"\n    fi\n\n    echo \"**\"\n    echo \"** Different ways to setup OpenFOAM (www.openfoam.com)\"\n    echo \"** - shell session:                 /usr/bin/$package\"\n    echo \"** - select for login shell:        $selector\"\n    echo \"** - source from ~/.bashrc file:  . $projectDir/etc/bashrc\"\n    echo \"**\"\n    echo \"** Upgrade information: www.openfoam.com/documentation/\"\n    echo \"**\"\n    ;;\n\nabort-upgrade|abort-remove|abort-deconfigure)\n    ;;\n\n*)\n    #echo \"postinst called with unknown argument '$1'\" 1>&2\n    #exit 1\n    ;;\nesac\n\n\n\nexit 0 # clean exit\n\n# ---------------------------------------------------------------------------\n",
        "./postrm": "#!/bin/sh\n# Copyright (C) 2020 OpenCFD Ltd.\n# SPDX-License-Identifier: (GPL-3.0+)\n#\n# A postrm for openfoam2412 runtime - see dh_installdeb(1)\n# See http://www.debian.org/doc/debian-policy/ or\n# the debian-policy package\n\nprefix=\"/usr/lib/openfoam\"\npackage=\"${DPKG_MAINTSCRIPT_PACKAGE}\"\nprojectDir=\"$prefix/$package\"\nselector=\"/usr/bin/openfoam-selector\"\n\ncase \"$1\" in\nremove | purge)\n    # Deregister from openfoam-selector as needed\n    if [ -f \"$selector\" ] && [ -x \"$selector\" ]\n    then\n        if [ \"$($selector --system --query)\" = \"$package\" ]\n        then\n            \"$selector\" --system --unset --yes\n        fi\n        if \"$selector\" --unregister \"$package\" --yes\n        then\n            echo \"Unregistered '$package' from openfoam-selector\"\n        else\n            echo \"No '$package' to unregister from openfoam-selector\"\n        fi\n    fi\n    echo \"Removed OpenFOAM shell session: /usr/bin/$package\"\n    echo \"Removed OpenFOAM installation : $prefix/$package\"\n\n    # Remind users about possible need to change ~/.bashrc\n    echo \"**\"\n    echo \"** Update ~/.bashrc files to remove the following line:\"\n    echo \"**\"\n    echo \"**    . $projectDir/etc/bashrc\"\n    echo \"**\"\n    ;;\n\nupgrade)\n    ;;\n\n*)\n    #echo \"postrm called with unknown argument '$1'\" 1>&2\n    #exit 1\n    ;;\nesac\n\n\n\nexit 0 # clean exit\n\n# ---------------------------------------------------------------------------\n"
      }
    },
