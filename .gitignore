.venv/
__pycache__/
*.pyc
Precision_5560_Wall_Mount_Package.zip
package_manifest.json
*_log.txt
# Unpacked CFD evidence is generated locally; tracked case dictionaries remain visible.
cfd/*/[1-9]*/
cfd/*/VTK/
cfd/*/constant/polyMesh/
cfd/*/*.log

# Local credentials, tool caches and duplicate build outputs
.env
.env.*
!.env.example
/tmp/
/output/
/%SystemDrive%/

# Minimalist build intermediates; reviewed reports and delivery archives are tracked.
/minimalist/scratch/
/minimalist/snapshots/
/minimalist/slices/
/minimalist/presets/*/*.FCStd1
/minimalist/*.FCStd1
/minimalist/*.[0-9]*.FCStd
/00000.log
/result.json

**/node_modules/

/minimalist/M1*History.png
/minimalist/assembly_preview.png
/minimalist/browser/*.png
# Preserved local CFD meshes, partitioned fields and failed trials can be many GB.
/fusion/cfd/runs/
/fusion/cfd/geometry_revh_prepare.log
/freecad/ValidationSnapshot.FCStd

# H-R1 retained native backups and local slicing intermediates.
/revh_retention/*.FCStd1
/revh_retention/*.[0-9]*.FCStd
/revh_retention/slices/
/revh_retention/browser/*.png
/revh_retention/*.FCBak
